{
  "name": "olr-scout-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --noEmit",
    "preview": "vite preview",
    "build:demo": "VITE_DEMO=1 VITE_BASE=/olr-scout/ tsc -b && VITE_DEMO=1 VITE_BASE=/olr-scout/ vite build && cp dist/index.html dist/404.html",
    "demo": "VITE_DEMO=1 vite"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.3",
    "vite": "5.4.10"
  }
}
