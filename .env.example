# Required: the single login password. There is no sign-up.
OLR_SCOUT_PASSWORD=change-me
# Signs the session cookie. Generate with: python -c "import secrets;print(secrets.token_hex(32))"
OLR_SCOUT_SECRET=
# Put a contact (email or URL) in the User-Agent so site owners can reach you.
OLR_SCOUT_CONTACT=
# Polling (floors: 60 s full, 20 s hot — lower values are raised to these).
OLR_SCOUT_FULL_REFRESH_SECONDS=600
OLR_SCOUT_HOT_REFRESH_SECONDS=20
# Results source base URL (unofficial API).
OLR_SCOUT_BENZING_BASE_URL=https://oneloftrace.live
# Web push (optional). Generate with: npx web-push generate-vapid-keys
OLR_SCOUT_VAPID_PUBLIC_KEY=
OLR_SCOUT_VAPID_PRIVATE_KEY=
OLR_SCOUT_VAPID_SUBJECT=mailto:you@example.com
